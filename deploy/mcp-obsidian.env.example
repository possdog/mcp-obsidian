# mcp-obsidian environment file.
#
# Copy to /etc/mcp-obsidian/env and fill in real values. Keep mode 600;
# this file contains the bearer token every MCP client will use.

# Vault root directory (required). This must be the vault you bound with
# `ob sync-setup`.
VAULT_PATH=/srv/mcp-obsidian/vault

# Search index location. The default would sit next to the vault, but an
# explicit path keeps ProtectSystem=strict ReadWritePaths simple.
INDEX_DIR=/var/lib/mcp-obsidian/index

# HTTP listen address. 127.0.0.1: reverse proxy in front. Change only if
# you are exposing the listener directly (and then set ALLOWED_HOSTS).
BIND_ADDR=127.0.0.1:8080

# Bearer token for MCP clients (required). Generate with:
#   openssl rand -hex 32
AUTH_TOKEN=

# Path to the Obsidian Headless binary (default: ob on PATH).
# OB_BIN=/usr/bin/ob

# Comma-separated allowed Host header values. Set to the public hostname(s)
# your reverse proxy forwards, e.g. mcp.example.com. Unset = no validation;
# acceptable when the listener is loopback-only and token-gated.
# ALLOWED_HOSTS=mcp.example.com

# Daily note overrides. Unset = auto-detect from the vault's own
# .obsidian/daily-notes.json, then conventional folders.
# DAILY_NOTES_DIR=Daily Notes
# DAILY_NOTE_FORMAT=YYYY-MM-DD.md

# Log filter (tracing EnvFilter syntax), default "info".
# RUST_LOG=mcp_obsidian=debug
